# Copy to .env.local for local development. Never commit real secrets.

# Public site identity (exposed to the browser)
NEXT_PUBLIC_SITE_NAME=VenusUI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_URL=https://github.com/Armaan42/venusui

# Registry namespace shown in install commands
NEXT_PUBLIC_REGISTRY_NAMESPACE=@venusui

# Accounts (Supabase). Both are public values. Leave them unset to turn accounts off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

/**
 * Writes `docs/assets.md`: the internal record of every externally sourced
 * image (URL, provider, license, attribution, where it's used). It's for
 * project management and compliance, not for the site, which never shows
 * provider names or badges.
 *
 *   npm run assets:record          write the record
 *   npm run assets:record -- check fail if the record is out of date
 */
import { readdirSync, readFileSync, statSync, writeFileSync, mkdirSync } from "node:fs"
import path from "node:path"

const ROOT = path.resolve(import.meta.dirname, "..")
const SCAN = ["registry/default", "src"]
const OUT = path.join(ROOT, "docs/assets.md")

/** Providers we source from, and what their license asks of us. */
const PROVIDERS = {
  unsplash: {
    name: "Unsplash",
    pattern: /images\.unsplash\.com\/photo-|photo\(\s*"|portrait\(\s*"|face\(\s*"|cover\(\s*"|unsplash\(\s*"/,
    url: (id: string) => `https://images.unsplash.com/photo-${id}`,
    license: "Unsplash License (https://unsplash.com/license)",
    terms:
      "Free for commercial and non-commercial use without permission. Photos may not be sold without significant modification, or compiled to build a similar or competing image service.",
    attribution: "Not required.",
  },
}

const ID = /\b(\d{10,13}-[0-9a-f]{6,})\b/g

function walk(dir: string): string[] {
  return readdirSync(dir).flatMap((name) => {
    const full = path.join(dir, name)
    if (statSync(full).isDirectory()) return name === "__registry__" ? [] : walk(full)
    return /\.(tsx?|mts)$/.test(name) ? [full] : []
  })
}

const uses = new Map<string, Set<string>>()
for (const base of SCAN) {
  for (const file of walk(path.join(ROOT, base))) {
    const text = readFileSync(file, "utf8")
    if (!PROVIDERS.unsplash.pattern.test(text)) continue
    for (const match of text.matchAll(ID)) {
      const rel = path.relative(ROOT, file).split(path.sep).join("/")
      if (!uses.has(match[1])) uses.set(match[1], new Set())
      uses.get(match[1])!.add(rel)
    }
  }
}

const p = PROVIDERS.unsplash
const rows = [...uses.entries()]
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([id, files]) => `| [${id}](${p.url(id)}) | ${p.name} | ${[...files].sort().map((f) => `\`${f}\``).join("<br>")} |`)

const record = `# External asset record

Internal record of every externally sourced image used by VenusUI. It is for
project management and compliance only. The site never shows provider names,
logos, badges or watermarks.

Generated by \`npm run assets:record\`. Don't edit by hand.

## Providers

| Provider | License | Terms | Attribution |
| --- | --- | --- | --- |
| ${p.name} | ${p.license} | ${p.terms} | ${p.attribution} |

## Checks before adding an image

- No logos, company names, watermarks, branded signage or screenshots of another product.
- If an image shows prominent third-party branding, pick another one. Never edit an image to hide required attribution.
- Write accurate \`alt\` text.

## Assets (${rows.length})

| Asset | Provider | Used in |
| --- | --- | --- |
${rows.join("\n")}
`

if (process.argv.includes("check")) {
  let current = ""
  try {
    current = readFileSync(OUT, "utf8")
  } catch {}
  if (current !== record) {
    console.error("docs/assets.md is out of date. Run npm run assets:record.")
    process.exit(1)
  }
  console.log(`✓ docs/assets.md lists all ${rows.length} assets`)
} else {
  mkdirSync(path.dirname(OUT), { recursive: true })
  writeFileSync(OUT, record)
  console.log(`✓ wrote docs/assets.md (${rows.length} assets)`)
}

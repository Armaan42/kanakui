/**
 * Captures a dark and a light screenshot of every block, for the homepage
 * block wall. Run it against a running site after adding or changing blocks:
 *
 *   npm run build && npm run start          (in one terminal)
 *   npm run thumbnails                      (in another)
 *
 * Writes public/thumbnails/<name>-{dark,light}.jpg and the list of captured
 * blocks to src/config/block-thumbnails.ts, which the homepage reads, so a
 * block without screenshots is simply left off the wall.
 *
 * Options (environment variables):
 *   BASE_URL  site to capture (default http://localhost:3000)
 *   ONLY      comma-separated block names to capture (default: all blocks)
 */
import { mkdir, readdir, writeFile } from "node:fs/promises"
import path from "node:path"
import { chromium } from "playwright"

const root = path.resolve(import.meta.dirname, "..")
const outDir = path.join(root, "public", "thumbnails")
const manifest = path.join(root, "src", "config", "block-thumbnails.ts")
const baseUrl = (process.env.BASE_URL ?? "http://localhost:3000").replace(/\/$/, "")

const allBlocks = (await readdir(path.join(root, "registry", "default", "blocks"), { withFileTypes: true }))
  .filter((entry) => entry.isDirectory())
  .map((entry) => entry.name)
  .sort()
const only = process.env.ONLY?.split(",").map((name) => name.trim()).filter(Boolean)
const targets = only ? allBlocks.filter((name) => only.includes(name)) : allBlocks

await mkdir(outDir, { recursive: true })
const browser = await chromium.launch()
const failed: string[] = []

try {
  for (const theme of ["dark", "light"] as const) {
    // Blocks are laid out at laptop width (1280x800) and saved at half size,
    // 640x400: sharp at the wall's largest tile (320px wide) on 2x screens.
    const context = await browser.newContext({
      viewport: { width: 1280, height: 800 },
      deviceScaleFactor: 0.5,
      colorScheme: theme,
    })
    const page = await context.newPage()
    for (const name of targets) {
      const response = await page.goto(`${baseUrl}/view/${name}?theme=${theme}`, { waitUntil: "networkidle" })
      if (response?.status() !== 200) {
        failed.push(`${name} (${theme}): HTTP ${response?.status()}`)
        continue
      }
      // Let entrance animations, number tickers and 3D scenes settle.
      await page.waitForTimeout(2500)
      await page.screenshot({ path: path.join(outDir, `${name}-${theme}.jpg`), type: "jpeg", quality: 80 })
      console.log(`captured ${name} (${theme})`)
    }
    await context.close()
  }
} finally {
  await browser.close()
}

if (failed.length) {
  console.error(`\nFailed:\n  ${failed.join("\n  ")}`)
  process.exit(1)
}

// The manifest lists every block that has both screenshots on disk.
const files = new Set(await readdir(outDir))
const captured = allBlocks.filter((name) => files.has(`${name}-dark.jpg`) && files.has(`${name}-light.jpg`))
await writeFile(
  manifest,
  `// Generated by scripts/block-thumbnails.mts. Do not edit by hand.\n` +
    `// Blocks with dark and light screenshots in public/thumbnails.\n` +
    `export const blockThumbnails: readonly string[] = ${JSON.stringify(captured, null, 2)}\n`
)
console.log(`\n${captured.length} blocks have thumbnails. Wrote ${path.relative(root, manifest)}.`)

/**
 * Generates src/styles/themes.css from src/config/themes.ts. Run it after
 * changing a base color, accent or radius:
 *
 *   node scripts/themes.mts
 *
 * The theme picker sets data-base, data-accent and data-radius on <html>.
 * Each rule also reaches `.light` and `.dark` sections inside the page (the
 * site's always-dark stages and light tiles), and every selector is more
 * specific than the plain `:root`, `.light` and `.dark` blocks in
 * globals.css, so the chosen theme wins wherever those apply.
 */
import { writeFile } from "node:fs/promises"
import path from "node:path"

import { ACCENTS, BASE_COLORS, RADII, type ThemeVars } from "../src/config/themes.ts"

const root = path.resolve(import.meta.dirname, "..")

const declarations = (vars: ThemeVars) =>
  Object.entries(vars)
    .map(([name, value]) => `  --${name}: ${value};`)
    .join("\n")

function rules(attribute: string, value: string, light: ThemeVars, dark: ThemeVars) {
  const a = `[data-${attribute}="${value}"]`
  const out: string[] = []
  if (Object.keys(light).length) out.push(`:root${a},\n${a} .light {\n${declarations(light)}\n}`)
  if (Object.keys(dark).length) out.push(`:root${a}.dark,\n${a} .dark {\n${declarations(dark)}\n}`)
  return out.join("\n\n")
}

const sections: string[] = [
  "/* Generated by scripts/themes.mts from src/config/themes.ts. Do not edit by hand. */",
  "/* Base colors (shadcn's official palettes). */",
]
for (const [name, base] of Object.entries(BASE_COLORS)) sections.push(rules("base", name, base.light, base.dark))

// Accents come after base colors: same specificity, so they win for the
// variables they set.
sections.push("/* Accent colors. */")
for (const [name, accent] of Object.entries(ACCENTS)) {
  if (name === "default") continue
  const withSidebar = (vars: ThemeVars) => ({
    ...vars,
    "sidebar-primary": vars.primary!,
    "sidebar-primary-foreground": vars["primary-foreground"]!,
    "sidebar-ring": vars.ring!,
  })
  sections.push(rules("accent", name, withSidebar(accent.light), withSidebar(accent.dark)))
}

sections.push("/* Corner radius. */")
for (const radius of RADII) {
  const a = `[data-radius="${radius}"]`
  sections.push(`:root${a},\n${a} .light,\n${a} .dark {\n  --radius: ${radius}rem;\n}`)
}

const file = path.join(root, "src", "styles", "themes.css")
await writeFile(file, sections.join("\n\n") + "\n")
console.log(`Wrote ${path.relative(root, file)}`)

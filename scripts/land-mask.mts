/**
 * Builds the land mask for the Arc Globe component (registry/default/ui/arc-globe.tsx): a 360x180 bitmap (one bit
 * per 1° of longitude and latitude, 1 = land) from Natural Earth's 1:110m
 * land shapes in the world-atlas package. Run it again only if you want a
 * different resolution:
 *
 *   node scripts/land-mask.mts
 *
 * Writes registry/default/lib/land-mask.ts (about 11 KB as base64), which the
 * CLI installs alongside the component.
 */
import { readFile, writeFile } from "node:fs/promises"
import path from "node:path"
import { geoContains } from "d3-geo"
import { feature } from "topojson-client"
import type { Topology } from "topojson-specification"

const root = path.resolve(import.meta.dirname, "..")
const WIDTH = 360
const HEIGHT = 180

const topology = JSON.parse(
  await readFile(path.join(root, "node_modules", "world-atlas", "land-110m.json"), "utf8")
) as Topology
const land = feature(topology, topology.objects.land!)

const bits = new Uint8Array((WIDTH * HEIGHT) / 8)
let count = 0
for (let row = 0; row < HEIGHT; row++) {
  const lat = 90 - row - 0.5
  for (let col = 0; col < WIDTH; col++) {
    const lon = col - 180 + 0.5
    if (geoContains(land, [lon, lat])) {
      const i = row * WIDTH + col
      bits[i >> 3]! |= 1 << (i & 7)
      count++
    }
  }
}

const base64 = Buffer.from(bits).toString("base64")
await writeFile(
  path.join(root, "registry", "default", "lib", "land-mask.ts"),
  `// Generated by scripts/land-mask.mts from Natural Earth 1:110m land (world-atlas). Do not edit by hand.\n` +
    `// A ${WIDTH}x${HEIGHT} bitmap, row 0 = 90°N, column 0 = 180°W, one bit per cell (1 = land).\n` +
    `export const LAND_MASK = { width: ${WIDTH}, height: ${HEIGHT}, data: "${base64}" } as const\n`
)
console.log(`${count} of ${WIDTH * HEIGHT} cells are land (${((count / (WIDTH * HEIGHT)) * 100).toFixed(1)}%).`)
